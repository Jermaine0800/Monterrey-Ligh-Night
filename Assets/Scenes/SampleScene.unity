  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d8d2cae2a037b842ad784c4f0005cf0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotaLeible
  titulo: "DIARIO DE MARIO \u2014 27/11/98"
  texto: "Llegamos a La Pastora a las 9. Rogelio dice que hay un t\xFAnel del metro
    que nunca terminaron, aqu\xED, en el cerro.\n\nHay un se\xF1or en el bosque.
    No dice nada. Solo saluda. Lo vimos tres veces.\n\nAna dice que lo vio sonre\xEDr
    detr\xE1s de su casa de campa\xF1a. Yo no vi nada.\n\nSon las 11:47. Otra vez
    son las 11:47."
