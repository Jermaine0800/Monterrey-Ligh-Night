  m_Script: {fileID: 11500000, guid: 5d8d2cae2a037b842ad784c4f0005cf0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotaLeible
  titulo: PISTAS DE AYER (mi letra)
  texto: "\xB7 La llave est\xE1 en el cuarto del fondo, frente al espejo. No mires
    el reflejo mucho tiempo.\n\xB7 En cuanto la tomas, la puerta de enfrente se azota
    y se va la luz.\n\xB7 El ropero de la rec\xE1mara grande. M\xE9tete AH\xCD. Debajo
    de la cama tambi\xE9n sirve.\n\xB7 La mecedora se mueve sola. No es nada. Creo."
