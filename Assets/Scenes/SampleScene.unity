  m_Script: {fileID: 11500000, guid: 5d8d2cae2a037b842ad784c4f0005cf0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotaLeible
  titulo: PISTAS DE AYER (mi letra)
  texto: "\xB7 La baliza roja. La llave cuelga de ah\xED.\n\xB7 Con la quinta llave
    vuelve al claro: aparece una puerta.\n\xB7 La niebla se pone roja. No es sangre,
    es la luz. (\xBFo s\xED?)\n\xB7 Esta vez llegu\xE9 hasta aqu\xED. Si lees esto,
    llegaste m\xE1s lejos que yo."
