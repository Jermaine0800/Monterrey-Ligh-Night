  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d8d2cae2a037b842ad784c4f0005cf0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotaLeible
  titulo: PISTAS DE AYER (mi letra)
  texto: "No me acuerdo de haber escrito esto, pero es mi letra.\n\n\xB7 La llave
    NO est\xE1 dentro de las casas de campa\xF1a. Ya busqu\xE9 tres veces.\n\xB7
    Brilla y gira. Se ve desde lejos si te alejas de la fogata.\n\xB7 El radio dice
    que no es el gu\xEDa. No s\xE9 qu\xE9 significa.\n\xB7 Cuando termin\xE9 de leer
    esto, algo sali\xF3 de entre los \xE1rboles. CORRE hacia la luz, no hacia el
    bosque."
