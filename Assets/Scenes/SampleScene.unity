  m_Script: {fileID: 11500000, guid: 5d8d2cae2a037b842ad784c4f0005cf0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotaLeible
  titulo: PISTAS DE AYER (mi letra)
  texto: "\xB7 Las velas de las tumbas: hay que prenderlas TODAS. Con una que falte,
    la cripta no abre.\n\xB7 La pala est\xE1 junto a una tumba abierta. Ll\xE9vatela.\n\xB7
    Dentro de la cripta no hay a d\xF3nde correr. Entra, toma la llave y sal sin
    voltear.\n\xB7 Ayer me agarr\xF3 entre las tumbas. Me escond\xED detr\xE1s de
    la cripta grande y funcion\xF3."
